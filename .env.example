# Bắt buộc: chuỗi ngẫu nhiên dài để ký token đăng nhập (backend không chạy nếu để trống)
SECRET_KEY = ""
# Thời hạn token đăng nhập, hết hạn thì phải đăng nhập lại (mặc định 8h)
JWT_EXPIRES_IN = 8h
REACT_URL = ""
RASA_URL = ""
RASA_TOKEN = ""
CALLBACK_URL = ""
MONGODB_URI = ""

# Redis cho hàng đợi train (BullMQ) và sự kiện tiến độ
REDIS_URL = redis://localhost:6379
# Thư mục model bên trong container Rasa
RASA_MODEL_DIR = /app/models
# Thời gian chờ tối đa một lần train (ms)
RASA_TRAIN_TIMEOUT_MS = 3600000

# Bot Telegram (để trống TELEGRAM_BOT_TOKEN để tắt bot)
# Token lấy từ @BotFather
TELEGRAM_BOT_TOKEN =
# Để trống khi dev: backend tự hỏi Telegram tin mới (long polling), không cần địa chỉ public.
# Khi deploy: địa chỉ https public trỏ tới POST /telegram/webhook của backend
TELEGRAM_WEBHOOK_URL =
# Bắt buộc khi dùng webhook: chuỗi ngẫu nhiên (chữ, số, _ -), Telegram gửi kèm mỗi lần gọi
TELEGRAM_WEBHOOK_SECRET =
# Câu gửi sang Rasa khi người dùng bấm Start (/start)
TELEGRAM_START_MESSAGE = xin chào
